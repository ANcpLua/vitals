{
  "$schema": "../schema/keys.schema.json",
  "keys": [
    {
      "kind": "keychain",
      "localCheck": {
        "provider": "claude"
      },
      "name": "Claude Code OAuth",
      "service": "Claude Code-credentials"
    },
    {
      "kind": "reference",
      "name": "GitHub RELEASE_TOKEN",
      "reference": "GitHub Actions secret RELEASE_TOKEN in ANcpLua/Qyl.OpenTelemetry.AutoInstrumentation and ANcpLua/Qyl.OpenTelemetry.SemanticConventions",
      "remoteChecks": [
        {
          "job": "github",
          "repository": "ANcpLua/Qyl.OpenTelemetry.AutoInstrumentation",
          "secrets": [
            "RELEASE_TOKEN"
          ],
          "workflow": "credential-health.yml"
        },
        {
          "job": "github",
          "repository": "ANcpLua/Qyl.OpenTelemetry.SemanticConventions",
          "secrets": [
            "RELEASE_TOKEN"
          ],
          "workflow": "credential-health.yml"
        }
      ]
    },
    {
      "kind": "reference",
      "name": "Railway RAILWAY_TOKEN (qyl / production)",
      "reference": "GitHub Actions secret RAILWAY_TOKEN in ANcpLua/qyl.mcp",
      "remoteChecks": [
        {
          "job": "railway",
          "repository": "ANcpLua/qyl.mcp",
          "secrets": [
            "RAILWAY_TOKEN"
          ],
          "workflow": "credential-health.yml"
        }
      ]
    },
    {
      "kind": "file",
      "localCheck": {
        "envFile": "~/.config/vitals/store-secrets.env",
        "options": {
          "EDGE_OPERATION_ID": "899b2074-4ad5-496f-861a-b08b7b3e54f4",
          "EDGE_PRODUCT_ID": "214e0682-5cde-4319-9608-ed25de6643b7"
        },
        "provider": "edge"
      },
      "name": "Browser store credentials (Edge + Firefox AMO)",
      "path": "~/.config/vitals/store-secrets.env",
      "remoteChecks": [
        {
          "job": "edge",
          "repository": "ANcpLua/save-media",
          "secrets": [
            "EDGE_CLIENT_ID",
            "EDGE_API_KEY"
          ],
          "workflow": "credential-health.yml"
        },
        {
          "job": "edge",
          "repository": "ANcpLua/yt-transcript",
          "secrets": [
            "EDGE_CLIENT_ID",
            "EDGE_API_KEY"
          ],
          "workflow": "credential-health.yml"
        }
      ]
    },
    {
      "kind": "file",
      "localCheck": {
        "clientFile": "~/.config/vitals/cws-client.json",
        "provider": "chrome",
        "refreshFile": "~/.config/vitals/cws-refresh-token.txt"
      },
      "name": "Chrome Web Store OAuth client",
      "path": "~/.config/vitals/cws-client.json",
      "remoteChecks": [
        {
          "job": "chrome",
          "repository": "ANcpLua/save-media",
          "secrets": [
            "CWS_CLIENT_ID",
            "CWS_CLIENT_SECRET",
            "CWS_REFRESH_TOKEN",
            "CWS_PUBLISHER_ID"
          ],
          "workflow": "credential-health.yml"
        },
        {
          "job": "chrome",
          "repository": "ANcpLua/yt-transcript",
          "secrets": [
            "CWS_CLIENT_ID",
            "CWS_CLIENT_SECRET",
            "CWS_REFRESH_TOKEN",
            "CWS_PUBLISHER_ID"
          ],
          "workflow": "credential-health.yml"
        }
      ]
    },
    {
      "kind": "file",
      "localCheck": {
        "clientFile": "~/.config/vitals/cws-client.json",
        "provider": "chrome",
        "refreshFile": "~/.config/vitals/cws-refresh-token.txt"
      },
      "name": "Chrome Web Store refresh token",
      "path": "~/.config/vitals/cws-refresh-token.txt",
      "remoteChecks": [
        {
          "job": "chrome",
          "repository": "ANcpLua/save-media",
          "secrets": [
            "CWS_CLIENT_ID",
            "CWS_CLIENT_SECRET",
            "CWS_REFRESH_TOKEN",
            "CWS_PUBLISHER_ID"
          ],
          "workflow": "credential-health.yml"
        },
        {
          "job": "chrome",
          "repository": "ANcpLua/yt-transcript",
          "secrets": [
            "CWS_CLIENT_ID",
            "CWS_CLIENT_SECRET",
            "CWS_REFRESH_TOKEN",
            "CWS_PUBLISHER_ID"
          ],
          "workflow": "credential-health.yml"
        }
      ]
    },
    {
      "kind": "keychain",
      "localCheck": {
        "provider": "auth0"
      },
      "name": "qyl hosted MCP refresh token",
      "service": "qyl-mcp-hosted-refresh"
    },
    {
      "kind": "keychain",
      "localCheck": {
        "provider": "auth0"
      },
      "name": "qyl hosted MCP client id",
      "service": "qyl-mcp-hosted-client-id"
    },
    {
      "kind": "keychain",
      "localCheck": {
        "keychainService": "AMO API (addons.mozilla.org)",
        "provider": "amo"
      },
      "name": "AMO API",
      "remoteChecks": [
        {
          "job": "amo",
          "repository": "ANcpLua/save-media",
          "secrets": [
            "AMO_JWT_ISSUER",
            "AMO_JWT_SECRET"
          ],
          "workflow": "credential-health.yml"
        },
        {
          "job": "amo",
          "repository": "ANcpLua/yt-transcript",
          "secrets": [
            "AMO_JWT_ISSUER",
            "AMO_JWT_SECRET"
          ],
          "workflow": "credential-health.yml"
        }
      ],
      "service": "AMO API (addons.mozilla.org)"
    },
    {
      "kind": "file",
      "localCheck": {
        "envFile": "~/.config/vitals/store-secrets.env",
        "provider": "amo"
      },
      "name": "Firefox AMO credentials in publishing file",
      "path": "~/.config/vitals/store-secrets.env",
      "remoteChecks": [
        {
          "job": "amo",
          "repository": "ANcpLua/save-media",
          "secrets": [
            "AMO_JWT_ISSUER",
            "AMO_JWT_SECRET"
          ],
          "workflow": "credential-health.yml"
        },
        {
          "job": "amo",
          "repository": "ANcpLua/yt-transcript",
          "secrets": [
            "AMO_JWT_ISSUER",
            "AMO_JWT_SECRET"
          ],
          "workflow": "credential-health.yml"
        }
      ]
    },
    {
      "kind": "file",
      "name": "Gemini for Diktat Fast",
      "note": "Encrypted key owned by Diktat Fast. Vitals checks presence only. Run diktat-fast check to verify authentication through Diktat without exposing the key.",
      "path": "~/Library/Application Support/Diktat Fast/gemini-key.enc",
      "url": "https://aistudio.google.com/api-keys"
    },
    {
      "kind": "file",
      "name": "Diktat Fast local app bridge",
      "note": "Private local bridge for ChatGPT, Claude Desktop, Claude Code, and Ghostty. Run diktat-fast doctor for named setup checks. Vitals checks presence only. Do not copy this token into chats.",
      "path": "~/Library/Application Support/Diktat Fast/bridge/access-token"
    },
    {
      "kind": "file",
      "name": "React Bits Pro license (Ultimate)",
      "note": "Use as REACTBITS_LICENSE_KEY for shadcn @reactbits-starter and @reactbits-pro installs. Do not copy into chats.",
      "path": "~/.config/vitals/reactbits-license-key",
      "url": "https://pro.reactbits.dev"
    },
    {
      "kind": "file",
      "name": "Resend API key (otel.cc sending)",
      "note": "Use as RESEND_API_KEY. Sending access, restricted to the domain otel.cc. Deployed copy: Railway variable RESEND_API_KEY, project leitwert, service projektaufnahme, environment production. After replacing this file, set that Railway variable from it. Do not copy into chats.",
      "path": "~/.config/vitals/resend-leitwert-key",
      "url": "https://resend.com/api-keys"
    },
    {
      "kind": "reference",
      "name": "Railway variables (leitwert / projektaufnahme)",
      "note": "Variable names are declared in .railway/railway.ts of ANcpLua/leitwert-gateway; values live only on Railway. Change them through that file and railway config apply.",
      "reference": "Railway project leitwert, service projektaufnahme, environment production",
      "url": "https://railway.com/project/98e774a7-8b95-4a87-83be-f878fb52ba1c"
    }
  ]
}
